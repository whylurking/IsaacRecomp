; IsaacRecomp mod. Turn it on or off with tools/mod_manager.html (or "mods =" in isaac.ini).
id = basetime
name = BaseTime
version = 1.2
author = IsaacRecomp
category = HUD
summary = Run timers (game time and total time), and your best and last times on the main menu.
description = Speedrun timers. Next to the map (with WideSaac's Hyper Zoom, at the room's bottom left): the game time (mm:ss: the time you can move; it stops while paused, in cutscenes and while loading) and below it the total time (mm:ss:mmm: everything since the run started, pauses and loading included). The main menu shows, on a note of its own, your best time - the fastest run to the furthest ending you have reached: Mom, then Mom's Heart, then Isaac or Satan, then The Chest - (game time), and below it your last run's total time, with "win" (it reached an ending) or "died". It only reads the game: runs play exactly the same with it on.

; options
; opacity = 10-100 (%)
opacity = 90
