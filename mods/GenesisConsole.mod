; IsaacRecomp mod. Turn it on or off with tools/mod_manager.html (or "mods =" in isaac.ini).
id = genesis
name = GenesisConsole
version = 1.0
author = IsaacRecomp
description = A console to type commands during a run, like Rebirth's: give items, spawn trinkets, cards, pills, pickups, enemies and bosses, change your stats, hearts and pickups, god mode, open doors, teleport to any room or floor, and more. Open it with the key above Tab, the controller's Back / Minus button, or a tap with three fingers.
warning = While this mod is on, NOTHING is saved and nothing can be unlocked: no achievements, unlocks, statistics or collection, and option changes are not kept either. Your save is not touched: turn the mod off to play normally again.
help = genesis_wiki.html

; options
; key = the keyboard key that opens the console: grave (the key above Tab) or a key name (F1, F2, F4...F10, Insert...)
key = grave
; pause = 1 pauses the game while the console is open (0: the game goes on)
pause = 1
; opacity = 30-100 (%) of the console's background
opacity = 85
; badge = 1 shows "GENESIS - NOT SAVED" in a corner during runs (0: hidden)
badge = 1
