; IsaacRecomp mod. Turn it on or off with tools/mod_manager.html (or "mods =" in isaac.ini).
id = rainbowvision
name = RainbowVision
version = 1.0
author = IsaacRecomp
engine = rainbow
description = Colours for colour-blind players: the whole picture is recoloured so the colours you can't tell apart (red and green, or blue and yellow) look different - hearts, pills, enemies, items. Choose your kind of colour blindness: protanopia (red-blind), deuteranopia (green-blind, the most common) or tritanopia (blue-blind). It only changes the colours on screen: runs play exactly the same with it on.

; options
; type = deuteranopia | protanopia | tritanopia: your kind of colour blindness
type = deuteranopia
; strength = 0-100 (%): how much the colours are changed
strength = 100
