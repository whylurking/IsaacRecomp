; IsaacRecomp mod. Turn it on or off with tools/mod_manager.html (or "mods =" in isaac.ini).
id = staton
name = StatOn
version = 1.0
author = IsaacRecomp
description = Shows your character's stats on the left of the screen during a run: speed, tears, damage, range, shot speed and luck, each with its symbol, and the chance of a devil room (and of an angel room) on this floor. When one changes, the difference appears next to it for a moment (green up, red down). Inspired by Repentance. It only reads the game: runs play exactly the same with it on.

; options
; show_changes = 1 shows the +/- next to a stat when it changes (0: never)
show_changes = 1
; show_deals = 1 shows the devil / angel room chances (0: only the stats)
show_deals = 1
; opacity = 10-100 (%)
opacity = 90
