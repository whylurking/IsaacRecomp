; IsaacRecomp mod. Turn it on or off with tools/mod_manager.html (or "mods =" in isaac.ini).
id = pilllog
name = PillLog
version = 1.0
author = IsaacRecomp
description = Pills you have already taken this run are known by sight: their effect is written over every pill of that colour lying in the room or for sale (green when it's a good one, red when not), the banner says the effect when you pick one up instead of "Pills here!", and the pause screen lists the six pill colours of the run with what each one does. The names are the game's own, as its HUD shows them. It only reads the game: runs play exactly the same with it on.

; options
; labels = 1 writes the effect over known pills in the room (0: no)
labels = 1
; banner = 1 shows the effect in the banner when you pick up a known pill (0: the game's "Pills here!")
banner = 1
; pause_list = 1 lists the pills of the run on the pause screen (0: no)
pause_list = 1
