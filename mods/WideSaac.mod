; IsaacRecomp mod. Turn it on or off with tools/mod_manager.html (or "mods =" in isaac.ini).
id = widesaac
name = WideSaac
version = 1.1
author = IsaacRecomp
description = The whole screen on wide (16:9, 16:10, 21:9...) and other screens: no black bars, the game's own background fills the sides, and the menus fill the whole screen; screen-wide shading (the pause screen, fades) covers the whole screen too. With Hyper Zoom, the room itself fills the screen during the whole run (paused and dead too; boss intros, floor cutscenes and endings are shown in the room's space with black sides, so the zoom never changes): the HUD band and the map go, and your hearts, active item and charges, coins, bombs, keys and pill / card are shown on the room's right side. With Hyper Zoom, M (L3 on a controller, a four-finger tap on a touch screen) shows or hides Minimap+: the map, larger and see-through, in the middle of the room. It only changes what is drawn: runs play exactly the same with it on.

; options
; hyper_zoom = 1: during play, the room fills the screen without the HUD band and the map (0: the whole game screen)
hyper_zoom = 0
; minimap = 1: with Hyper Zoom, M / L3 / four fingers show or hide Minimap+ (0: no map at all with Hyper Zoom)
minimap = 1
; fill = 1: the game's background around the game instead of black bars (0: black bars, as without the mod)
fill = 1
