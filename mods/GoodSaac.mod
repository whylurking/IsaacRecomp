; IsaacRecomp mod. Turn it on or off with tools/mod_manager.html (or "mods =" in isaac.ini).
id = goodsaac
name = Good Saac
version = 1.2
author = IsaacRecomp
category = Fixes
summary = Fixes bugs of the original games, most of them the way Eternal Edition later did.
engine = goodsaac
description = Fixes known bugs of the Flash games. In the original and Wrath of the Lamb: the wrong lines under some items' names when you pick them up (Sacred Heart said "Tears Up", MEAT! "Tears + HP Up"...), "Magdalena" and "XXX" in mini-boss banners, an Eternal Heart that didn't save ??? (or anyone with no heart containers left), Mom's Heart saying "Isaac!" over and over in its last phase. In every version: the challenge room's music going on after you leave the room by teleport or an extra life. Also: "<3" with no name in the collection, an empty picture in the death diary (Razor Blade, "killed by nothing"), pills for sale that change colour when bought, challenge waves coming all at once after a pause, a red screen that stays after Mom, The Gamekid leaving the head flipped, Daddy Longlegs stomping only once on bosses that don't move, Mom's or Satan's foot hurting you after they die, secrets unlocked by the wrong deed (Headless Horseman, The Chest with ??? and Eve), XL Depths' first boss treated as Mom, Forget Me Now turning the Cathedral into Sheol, two secrets per key on the secrets screen no sound when choosing a character with the keys, the devil / angel room door hidden after Mom, and the game freezing when no item is left to give (it gives Breakfast, as Rebirth does). Each fix can be turned off on its own.

; options
; subtitles = 1 corrects the line under the name of 14 items (original and Wrath of the Lamb) (0: no)
subtitles = 1
; names = 1 writes Magdalene and ??? in mini-boss banners (original and Wrath of the Lamb) (0: no)
names = 1
; eternal_heart = 1 lets an Eternal Heart save a character with no heart containers, as in Eternal Edition (0: no)
eternal_heart = 1
; mom_voice = 1 stops Mom's Heart / It Lives! repeating "Isaac!" many times in a row (0: no)
mom_voice = 1
; challenge_music = 1 stops the challenge room's music when you leave the room (0: no)
challenge_music = 1
; heart_name = 1 shows the name of <3 in the collection (0: no)
heart_name = 1
; last_will = 1 fills the death diary's empty pictures (Razor Blade, "killed by nothing") (0: no)
last_will = 1
; shop_pills = 1 shows pills for sale in the colour they have when you use them (0: no)
shop_pills = 1
; challenge_pause = 1 stops challenge waves coming while the game is paused (0: no)
challenge_pause = 1
; mom_red = 1 puts the screen's colour back if you leave the room during Mom's red flash (0: no)
mom_red = 1
; gamekid_head = 1 turns the head back the right way when The Gamekid ends (0: no)
gamekid_head = 1
; daddy_stomps = 1 lets Daddy Longlegs keep stomping bosses that don't move (0: no)
daddy_stomps = 1
; foot_shadow = 1 stops Mom's and Satan's foot hurting you once they are dead (0: no)
foot_shadow = 1
; mom_deals = 1 shows the devil / angel room door in Mom's room once she is dead (0: no)
mom_deals = 1
; breakfast = 1 gives Breakfast when no item is left to give instead of freezing (0: no)
breakfast = 1
; unlocks = 1 unlocks the right secrets (Headless Horseman, The Chest with ??? / Eve) (0: no)
unlocks = 1
; xl_depths = 1 makes XL Depths' first boss a normal boss, not Mom (0: no)
xl_depths = 1
; forget_me_now = 1 keeps the Cathedral a Cathedral after Forget Me Now (0: no)
forget_me_now = 1
; secrets_keys = 1 moves one secret per arrow key on the secrets screen (0: no)
secrets_keys = 1
; select_click = 1 plays the click when you change character with the keys (0: no)
select_click = 1
