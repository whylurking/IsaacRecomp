; IsaacRecomp mod. Turn it on or off with tools/mod_manager.html (or "mods =" in isaac.ini).
id = itemnomicon
name = Itemnomicon
version = 1.2
author = IsaacRecomp
description = Walk up to an item, a trinket or a card you can pick up or buy, and a card over it tells you what it is: its name (in the colour of its quality: grey 0, white 1, blue 2, violet 3, gold 4, as Rebirth rates the same items), what kind of thing it is (active items show their charges), the stats it changes (green up, red down) and what it does. The stat changes are the game's own, measured in each version of the game. It only reads the game: runs play exactly the same with it on.

; options
; range = 0.5-4: how close you have to be, in tiles (1: next to it)
range = 1
; opacity = 30-100 (%)
opacity = 100
